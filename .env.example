# Значения по умолчанию для docker compose.
# Скопируйте в .env, если нужно изменить порты или параметры.

# Порты, которые публикуются на хост
WEB_PORT=8080
API_PORT=3000
POSTGRES_PORT=5432

# Доступ к БД
POSTGRES_USER=food
POSTGRES_PASSWORD=food
POSTGRES_DB=food_orders

# Бизнес-настройки
COURIER_ACTIVE_LIMIT=3
SEARCH_SIMILARITY_THRESHOLD=0.5
