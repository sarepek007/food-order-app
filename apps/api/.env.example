# Подключение к БД приложения
DATABASE_URL=postgres://food:food@localhost:5432/food_orders
# Отдельная БД для интеграционных тестов (пересоздаётся тестами)
TEST_DATABASE_URL=postgres://food:food@localhost:5432/food_orders_test

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Бизнес-настройки
COURIER_ACTIVE_LIMIT=3
# Порог триграммного сходства для поиска по адресу (0..1). Обоснование: docs/adr/0005-fuzzy-address-search.md
SEARCH_SIMILARITY_THRESHOLD=0.5

CORS_ORIGIN=http://localhost:5173

# Переопределение нормативов времени на статус, секунды. Необязательно.
# STATUS_SLA_SECONDS={"preparing":1800,"ready":600}
